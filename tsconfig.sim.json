{
  // Simulación, protocolo y sala, compartidos con el servidor: sin DOM ni tipos de Vite, así `window` o `document` no compilan.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": []
  },
  "include": ["src/sim", "src/net/protocol.ts", "src/net/clock.ts", "src/net/predict.ts", "src/net/interp.ts", "server/room.ts"],
  "exclude": ["src/**/*.test.ts", "server/**/*.test.ts"]
}
