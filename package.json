{
  "name": "muck-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:server": "vitest run --config vitest.server.config.ts",
    "typecheck:sim": "tsc -p tsconfig.sim.json",
    "typecheck:server": "tsc -p tsconfig.server.json",
    "dev:server": "wrangler dev --config server/wrangler.jsonc --var ALLOW_LOCAL:1",
    "deploy:server": "wrangler deploy --config server/wrangler.jsonc"
  },
  "dependencies": {
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/three": "^0.186.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.3"
  }
}
